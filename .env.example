# ─── Base URL ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://yourdomain.com

# ─── Protected Routes ────────────────────────────────────────────────────────
# Password for /admin/* routes (stored hashed in cookie)
ADMIN_PASSWORD=change_me_in_production

# ─── Google Analytics ────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=SEU_CODIGO_AQUI

# ─── Ambiente da aplicação: development | production | test ──────────────────
NODE_ENV=development

# ─── Variáveis de configuração para as Atividades no Github ──────────────────
NEXT_PUBLIC_GITHUB_USERNAME=SEU_USERNAME_AQUI
GITHUB_TOKEN=SEU_TOKEN_AQUI

# ─── Define que a estratégia de cache será o Upstash ─────────────────────────
BLOG_VIEWS_STORE="upstash"

# ─── Credenciais do Upstash (copie do painel deles) ──────────────────────────
UPSTASH_REDIS_REST_URL="https://sua-url-do-upstash.upstash.io"
UPSTASH_REDIS_REST_TOKEN="SEU_TOKEN_AQUI"

# ─── Variáveis de configuração para os anúncios do Adsense ───────────────────
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_POST=1234567890
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=0987654321
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=1122334455

# ─── Mailchimp Newsletter ────────────────────────────────────────────────────
# 1. MAILCHIMP_API_KEY  →  Account & Billing → Extras → API Keys
#    Format: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us21
# 2. MAILCHIMP_SERVER_PREFIX  →  the suffix of your API key (e.g. "us21")
# 3. MAILCHIMP_AUDIENCE_ID  →  Audience → Settings → Audience name and defaults → Audience ID
MAILCHIMP_API_KEY=YOUR_API_KEY_HERE
MAILCHIMP_SERVER_PREFIX=us21
MAILCHIMP_AUDIENCE_ID=YOUR_AUDIENCE_ID_HERE

# ─── Chat with Tori (AI Agent) ─────────────────────────────────────────────
# Uses Google Gemini 2.5 Flash — FREE tier, no credit card required.
#
# How to get your key (2 minutes):
# 1. Go to https://aistudio.google.com/app/apikey
# 2. Click "Create API Key"
# 3. Copy the key and paste below
GOOGLE_GENERATIVE_AI_API_KEY=YOUR_GEMINI_API_KEY_HERE
