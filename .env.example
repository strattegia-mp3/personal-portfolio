# ─── Base URL ────────────────────────────────────────────────────────────────
# Required in production. On Vercel, VERCEL_URL is injected automatically
# as a fallback if this is not set.
NEXT_PUBLIC_BASE_URL=https://yourdomain.com

# ─── Protected Routes ────────────────────────────────────────────────────────
# Password for /admin/* routes (stored hashed in cookie)
ADMIN_PASSWORD=change-me-in-production

# ─── Mailchimp Newsletter ────────────────────────────────────────────────────
# How to get these values:
#
# 1. MAILCHIMP_API_KEY
#    Mailchimp Dashboard → Account & Billing → Extras → API Keys
#    Format: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us21
#
# 2. MAILCHIMP_SERVER_PREFIX
#    The datacenter prefix at the END of your API key (e.g. "us21")
#    It is also visible in your Mailchimp URL: https://us21.admin.mailchimp.com
#
# 3. MAILCHIMP_AUDIENCE_ID
#    Mailchimp Dashboard → Audience → All contacts → Settings → Audience name and defaults
#    Look for "Audience ID" (also called List ID). Format: abc123def4
#
MAILCHIMP_API_KEY=your-api-key-here
MAILCHIMP_SERVER_PREFIX=us21
MAILCHIMP_AUDIENCE_ID=your-audience-id-here

